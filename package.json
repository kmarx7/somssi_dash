    "test:smoke": "node scripts/smoke.mjs",
    "verify:originals": "python3 scripts/verify-originals.py"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
