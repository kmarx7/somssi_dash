{
  "name": "somssi-control-center",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @somssi/web",
    "build": "npm run build --workspace @somssi/web",
    "start": "npm run start --workspace @somssi/web",
    "lint": "npm run lint --workspace @somssi/web",
    "typecheck": "npm run typecheck --workspace @somssi/web",
    "test:smoke": "node scripts/smoke.mjs",
    "verify:originals": "python3 scripts/verify-originals.py",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:integration": "node --experimental-strip-types tests/operations-integration.mjs",
    "db:rules:check": "node --experimental-strip-types scripts/build-db-rules.mjs --check"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "prettier": "3.9.10"
  }
}
